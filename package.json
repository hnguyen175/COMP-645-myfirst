{
  "name": "monaca-template-onsenui-v2-js-minimum",
  "version": "4.1.4",
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "monaca-plugin-monaca-core": "3.3.1"
  },
  "cordova": {
    "plugins": {
      "monaca-plugin-monaca-core": {}
    }
  },
  "scripts": {
    "monaca:transpile": "tsc --listEmittedFiles",
    "monaca:preview": "tsc && npm run dev",
    "dev": "tsc && eslint . && browser-sync start -s www/ --watch --port 8080 --ui-port 8081",
    "sqlite:build": "node ./scripts/copy-sqlite.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browser-sync": "~2.27.7",
    "cordova": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3"
  }
}
