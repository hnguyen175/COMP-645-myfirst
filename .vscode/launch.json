{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start and debug Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx vite www",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:.*?(https?://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/www"
      }
    }
  ]
}